{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snailog",
  "version": "0.1.0",
  "identifier": "test.solanum.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Snailog IM",
        "width": 980,
        "height": 660,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["snailog"] }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
