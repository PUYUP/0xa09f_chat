listen ircs://:6697
listen irc+insecure://:6667
listen unix+admin:///db/soju-admin.sock

tls /soju-tls/tls-cert.pem /soju-tls/tls-key.pem

hostname irc.solanum.test
title "SolNet Bouncer"
auth internal
disable-inactive-user 30d
enable-user-on-auth true

db postgres "host=postgres dbname=soju user=soju sslmode=disable"
message-store db

motd /soju-tls/motd
