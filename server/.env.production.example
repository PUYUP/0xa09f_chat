# server/.env untuk PRODUKSI (snailog.com). Docs: docs/deploy.md §5.
#
# Jangan isi password dengan tangan. Jalankan:
#   ./scripts/gen-prod-env.sh
# Script itu menyalin file ini ke .env dan mengganti setiap __RANDOM__ dengan
# password acak (hex). Yang masih harus kamu isi sendiri hanya bagian
# "WAJIB DIISI" di bawah (SMTP + admin).
#
# Setelah .env jadi / berubah: ./scripts/sync-secrets.sh, lalu
# docker compose up -d.

# ======================================================================
# WAJIB DIISI
# ======================================================================

# Email keluar: reset password (api) dan email NickServ (atheme).
# Contoh Brevo: host smtp-relay.brevo.com, port 587, starttls,
# user = login SMTP Brevo, password = SMTP key dari dashboard Brevo.
# Domain pengirim (snailog.com) harus sudah diverifikasi + SPF/DKIM (deploy.md §3).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=__ISI_LOGIN_SMTP__
SMTP_PASSWORD=__ISI_SMTP_KEY__
MAIL_FROM=Snailog IM <no-reply@snailog.com>

# ID snailog yang boleh mengirim pengumuman 📢 ke semua orang (pisahkan koma).
# Daftar akunnya dulu lewat app, lalu isi di sini.
ADMIN_USERS=

# ======================================================================
# Password (diisi otomatis oleh scripts/gen-prod-env.sh)
# ======================================================================

# Link solanum <-> atheme (dua arah, harus berbeda)
LINK_SOLANUM_SEND=__RANDOM__
LINK_SOLANUM_ACCEPT=__RANDOM__

# Operator IRC "admin" (/OPER admin <password>). Simpan di password manager.
OPER_ADMIN_PASSWORD=__RANDOM__

# PostgreSQL untuk soju (users, networks, history pesan)
POSTGRES_USER=soju
POSTGRES_DB=soju
POSTGRES_PASSWORD=__RANDOM__

# Database service akun (role "snailog")
SNAILOG_DB_PASSWORD=__RANDOM__

# Akun NickServ pemilik #lobby (scripts/setup-rooms.py)
LOBBY_OWNER=snailog
LOBBY_OWNER_PASSWORD=__RANDOM__

# ======================================================================
# Jaringan: semua port HANYA localhost. Caddy (443) yang menghadap internet.
# Jangan pernah 0.0.0.0: port docker melewati firewall ufw.
# ======================================================================
BIND_ADDR=127.0.0.1
SOLANUM_BIND=127.0.0.1
SOJU_BIND=127.0.0.1

SOLANUM_PORT=6667
# dipakai scripts/setup-rooms.py + monitor.sh dari host
SOLANUM_TLS_PORT=6697
SOJU_PORT=16667
SOJU_TLS_PORT=16697
# Caddy: irc.snailog.com/socket -> sini
SOJU_WS_PORT=16668
# Caddy: irc.snailog.com/* -> sini
REGISTER_PORT=16680
# tidak dipakai di produksi (SMTP asli di atas)
MAILPIT_PORT=16825

# Caddy di host -> api lewat port docker: api melihat IP gateway docker.
# Pastikan dengan log api setelah request pertama lewat Caddy (deploy.md §5);
# tanpa nilai yang benar, rate limit berlaku untuk semua pengguna sekaligus.
TRUSTED_PROXIES=172.30.99.1

# ======================================================================
# Internal docker: biarkan seperti ini kecuali kamu tahu alasannya
# ======================================================================
SOJU_NETWORK=solanum
IRC_SUBNET=172.30.99.0/24
ATHEME_HOST=172.31.99.20
SOJU_HOST=172.30.99.30

# Akun yang dipakai scripts/monitor.sh untuk mengecek soju tersambung ke
# solanum. Isi dengan ID snailog yang sudah ada (mis. ID admin-mu).
# SOJU_PASSWORD (.env.example) hanya untuk tes lokal: tidak perlu di produksi.
SOJU_USER=

# PENTING: jangan menulis komentar di ujung baris (KEY=nilai  # komentar).
# scripts/setup-rooms.py dan monitor.sh membaca nilai mentah, komentarnya ikut.
