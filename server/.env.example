# Copy to .env and adjust, or run scripts/init-env.sh (copies this file and
# generates the empty secrets below). .env is gitignored.

# Generated by scripts/init-env.sh when empty:
POSTGRES_PASSWORD=        # postgres superuser
ERGO_DB_PASSWORD=         # role "ergo" (Ergo's message history)
A09F_DB_PASSWORD=         # role "a09f" (account service data)
ERGO_API_TOKEN=           # account service -> Ergo HTTP API
JWT_KEY=                  # account service signs logins for "send later"

# Host ports exposed by docker compose
IRC_PORT=16667            # IRC plaintext (the desktop app connects here)
IRC_TLS_PORT=16697        # IRC over TLS (self-signed)
API_PORT=16680            # account service (HTTP + live events)
MAILPIT_PORT=16825        # dev mail catcher web inbox (password-reset emails)

# Internal docker network
A09F_SUBNET=172.30.98.0/24

# Host bind address for published ports (127.0.0.1 = localhost only,
# 0.0.0.0 = reachable from LAN)
BIND_ADDR=127.0.0.1

# Password-reset email (account service). Unset = local Mailpit catcher
# (mailpit:1025, no TLS); view mail at http://127.0.0.1:16825.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURITY=starttls   # starttls | ssl | none
#SMTP_USER=
#SMTP_PASSWORD=
#MAIL_FROM=a09f <no-reply@example.com>

# a09f IDs allowed to send announcements to everyone (📢 in the app)
#ADMIN_USERS=pointilis
