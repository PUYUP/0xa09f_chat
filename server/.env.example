# Copy to .env and adjust. .env is gitignored.
# Link passwords (must match between solanum <-> atheme, direction matters):
LINK_SOLANUM_SEND=change-me-solanum-to-atheme
LINK_SOLANUM_ACCEPT=change-me-atheme-to-solanum

# IRC operator "admin" password (OPER). Hashed with sha512-crypt inside the
# solanum container at startup — the hash never touches the repo. Generate a
# strong one, e.g.: openssl rand -base64 24 | tr -dc 'A-Za-z0-9._~+-'
# Allowed charset: [A-Za-z0-9._~+-] (sed-safe).
OPER_ADMIN_PASSWORD=change-me-oper-password

# Soju bouncer user password (used by tests/test_soju.py)
SOJU_PASSWORD=change-me
SOJU_USER=pointilis
SOJU_NETWORK=solanum

# PostgreSQL for soju (users, networks, channels, message history)
POSTGRES_USER=soju
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soju

# Host ports exposed by docker compose.
# SOLANUM_PORT/SOJUPORT only bind to BIND_ADDR. Solanum requires TLS for all
# client connections (need_ssl) — plaintext ports only serve the rejection
# message, so on a public host bind everything to 127.0.0.1 except the TLS
# ports you actually need (6697/16697).
SOLANUM_BIND=127.0.0.1
SOLANUM_PORT=6667
SOLANUM_TLS_PORT=6697
SOJU_BIND=127.0.0.1
SOJU_PORT=16667
SOJU_TLS_PORT=16697
REGISTER_PORT=16680   # a09f account service (HTTP + live events)
MAILPIT_PORT=16825    # dev mail catcher web inbox (password-reset emails)

# Internal docker network
IRC_SUBNET=172.30.99.0/24

# IP solanum expects for the atheme container (connect block host match).
# This is atheme's address on the dedicated irc-link network (172.31.99.x),
# not its ircnet address — the services link is isolated from other
# containers. Static IPs are assigned in docker-compose.yml; docker DNS
# names don't work here because solanum matches the connect-block host
# against the peer IP.
ATHEME_HOST=172.31.99.20

# IP of the soju container (static in docker-compose.yml). Solanum exempts it
# from connection throttling and per-IP limits: all bouncer users share it.
# The value solanum actually uses comes from secrets/soju-host.ip (a docker
# secret; regenerate with scripts/soju-host-ip.sh after changing this IP).
SOJU_HOST=172.30.99.30

# Host bind address for published ports (127.0.0.1 = localhost only,
# 0.0.0.0 = reachable from LAN). Per-service overrides: SOLANUM_BIND,
# SOJU_BIND.
BIND_ADDR=127.0.0.1

# NickServ account that owns #lobby (scripts/setup-rooms.py).
# Leave the password empty/absent and the script generates one into .env.
LOBBY_OWNER=a09f
#LOBBY_OWNER_PASSWORD=

# Account service database password (role "a09f"); scripts/init-api-db.sh
# generates it and creates the role + database.
A09F_DB_PASSWORD=

# Outgoing email (SMTP). Dipakai DUA service: api (reset password a09f)
# dan atheme (email NickServ via msmtp — mis. aktivasi registrasi kalau
# auth=email dinyalakan). Untuk Brevo: SMTP_HOST=smtp-relay.brevo.com,
# SMTP_PORT=587, SMTP_SECURITY=starttls, SMTP_USER=<login email brevo>,
# SMTP_PASSWORD=<SMTP key dari brevo dashboard>, MAIL_FROM=<alamat verified>.
# Kosongkan semua = Mailpit dev catcher (mailpit:1025, web http://127.0.0.1:16825).
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURITY=starttls   # starttls | ssl | none
#SMTP_USER=
#SMTP_PASSWORD=
#MAIL_FROM=a09f <no-reply@example.com>

# a09f IDs allowed to send announcements to everyone (📢 in the app)
#ADMIN_USERS=pointilis

# Reverse proxies in front of the account service (comma-separated, IPv4 or
# IPv6; IPv6 is matched by /64). Their X-Forwarded-For / X-Real-IP is trusted
# for rate limits; without it, every client behind a proxy shares one bucket.
#TRUSTED_PROXIES=127.0.0.1
